---
import { href, menu } from '../data/site.js';
const { title='MNEMORİSK', description='Erzincan’da deprem hafızası, risk algısı ve sosyal zarar görebilirlik üzerine araştırma.' } = Astro.props;
const current = Astro.url.pathname;
const isEnglish = /\/en(?:\/|$)/.test(current);
const projectSubtitle = isEnglish
  ? 'Mnemonic Social Vulnerability: Integrating Collective Memory into Disaster Risk Management and Spatial Modelling in Erzincan, Türkiye'
  : 'Hafıza Temelli Sosyal Zarar Görebilirlik: Erzincan’da Toplumsal Hafızanın Afet Risk Yönetimine Entegrasyonu ve Mekânsal Modellemesi';
---
<!doctype html>
<html lang={isEnglish ? 'en' : 'tr'}>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f6f8fa"/>
<meta name="description" content={description}/>
<title>{title === 'MNEMORİSK' ? title : `${title} — MNEMORİSK`}</title>
<link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#172b3e;background:#f6f8fa;font-synthesis:none;--ink:#172b3e;--navy:#153c54;--line:#dde5eb;--muted:#607487;--accent:#bf674e}
*,*:before,*:after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px}
a{color:inherit;text-decoration:none}
button,input,textarea,select{font:inherit}
img,svg{max-width:100%}
:focus-visible{outline:3px solid #d47e5a;outline-offset:3px}
.wrap{width:min(1220px,calc(100% - 64px));margin-inline:auto}
.site-header{background:#fff;position:sticky;top:0;z-index:30;border-bottom:1px solid var(--line)}
.header-inner{display:flex;align-items:center;justify-content:space-between;gap:28px;min-height:93px;padding-block:12px}
.brand-group{display:flex;flex-direction:column;gap:6px;flex:0 1 410px;min-width:0}
.brand{display:block;font-size:28px;font-weight:800;letter-spacing:-.055em;line-height:1}
.brand em{font-style:normal;color:#ad553c}
.brand-subtitle{font-size:9.5px;line-height:1.35;font-weight:400;color:#667788;max-width:420px}
.desktop-nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(12px,1.45vw,23px)}
.nav{font-size:13px;font-weight:600}
.nav a{padding:10px 0;border-bottom:2px solid transparent;white-space:nowrap}
.nav a:hover,.nav a[aria-current=page]{color:#174b6c;border-bottom-color:#c06d54}
.lang{color:#718498;border-left:1px solid var(--line);padding-left:16px;font-size:11px;white-space:nowrap}
.menu-toggle{display:none;border:1px solid var(--line);background:#fff;padding:11px 14px;color:var(--ink);font-size:13px;font-weight:700;cursor:pointer}
.eyebrow,.kicker,.meta,.index{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#4c7290}
.button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;background:#153c54;color:white;padding:14px 20px;font-size:14px;font-weight:700;border:1px solid #153c54}
.button:hover{background:#245979}
.lead{font-size:clamp(17px,1.7vw,21px);line-height:1.6;color:#42596d;max-width:780px}
.page-intro{padding:55px 0 38px;border-bottom:1px solid var(--line)}
.page-intro h1{font-size:clamp(34px,3.9vw,51px);line-height:1.15;letter-spacing:-.04em;font-weight:700;margin:13px 0 16px;max-width:990px}
.page-intro p{font-size:clamp(16px,1.45vw,19px);color:#596c7e;line-height:1.55;margin:0;max-width:790px}
.article-list{padding:25px 0 85px}
.article-row{display:grid;grid-template-columns:minmax(210px,.9fr) 1.7fr;gap:35px;padding:31px 0;border-bottom:1px solid var(--line)}
.article-row h2{font-size:clamp(22px,2.4vw,30px);line-height:1.22;letter-spacing:-.025em;margin:0}
.article-row p{font-size:17px;line-height:1.7;color:#526577;margin:0}
.notice{background:#edf3f7;border-left:3px solid #6b91ab;padding:18px 22px;color:#425c70;font-size:14px;line-height:1.6}
.content-band{padding:70px 0;border-bottom:1px solid var(--line)}
.section-head{display:flex;justify-content:space-between;gap:24px;align-items:start}
.section-head h2{font-size:clamp(29px,3.5vw,43px);line-height:1.18;letter-spacing:-.035em;margin:12px 0 20px}
.text-link{font-size:13px;font-weight:700;color:#245979;border-bottom:1px solid #88a6bb;padding-bottom:5px;white-space:nowrap}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:28px}
.card{background:white;border:1px solid var(--line);padding:25px}
.card h3{font-size:22px;margin:24px 0 10px}
.card p{font-size:15px;color:#617487;line-height:1.65}
.site-footer{background:#102f44;color:#eaf1f5;padding:55px 0 32px}
.footer-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:36px}
.footer-title{font-size:31px;font-weight:800;letter-spacing:-.05em}
.site-footer p{max-width:610px;font-size:14px;line-height:1.65;color:#c5d6e0}
.footer-bottom{border-top:1px solid #456277;margin-top:38px;padding-top:24px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font-size:12px;color:#d2dce3}
.footer-bottom a{text-decoration:underline;text-underline-offset:3px}
.skip-link{position:absolute;left:-9999px;top:8px;background:white;color:#111;padding:12px;z-index:50}
.skip-link:focus{left:12px}
@media(max-width:1120px) and (min-width:901px){.brand-group{flex-basis:300px}.brand-subtitle{font-size:9px}.desktop-nav{gap:11px}.nav{font-size:12px}}
@media(max-width:900px){
 .wrap{width:calc(100% - 40px)}
 .header-inner{min-height:85px}
 .brand-group{flex:1;max-width:calc(100% - 100px)}
 .menu-toggle{display:block;flex-shrink:0}
 .desktop-nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:stretch;gap:0;padding:12px 22px 22px;background:white;border-bottom:1px solid var(--line);box-shadow:0 12px 24px #102f4415}
 .desktop-nav.open{display:flex}
 .desktop-nav a{padding:13px 0;border-bottom:1px solid var(--line)}
 .lang{border:0;padding:12px 0}
 .cards{grid-template-columns:1fr}
 .footer-grid{grid-template-columns:1fr}
}
@media(max-width:600px){
 .wrap{width:calc(100% - 32px)}
 .header-inner{min-height:92px;gap:12px}
 .brand{font-size:25px}
 .brand-subtitle{font-size:9px;line-height:1.3}
 .page-intro{padding:36px 0 28px}
 .page-intro h1{font-size:clamp(30px,8vw,40px)}
 .page-intro p{font-size:16px}
 .article-list{padding-bottom:55px}
 .article-row{grid-template-columns:1fr;gap:12px;padding:23px 0}
 .article-row p{font-size:16px}
 .content-band{padding:50px 0}
 .section-head{display:block}
 .text-link{display:inline-block;margin-bottom:12px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<a class="skip-link" href="#main">İçeriğe geç</a>
<header class="site-header">
 <div class="wrap header-inner">
  <a class="brand-group" href={href('')} aria-label="MNEMORİSK ana sayfa"><span class="brand">MNEMO<em>RİSK</em></span><span class="brand-subtitle">{projectSubtitle}</span></a>
  <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">MENÜ ☰</button>
  <nav class="desktop-nav nav" id="site-nav" aria-label="Ana menü">
   {menu.map(item=><a href={href(item.path)} aria-current={current.endsWith('/'+item.path) ? 'page' : undefined}>{item.label}</a>)}
   <span class="lang" title="İngilizce sürüm hazırlanıyor">TR / EN yakında</span>
  </nav>
 </div>
</header>
<main id="main"><slot/></main>
<footer class="site-footer">
 <div class="wrap">
  <div class="footer-grid">
   <div><div class="footer-title">MNEMORİSK</div><p>Hafıza Temelli Sosyal Zarar Görebilirlik: Erzincan’da Toplumsal Hafızanın Afet Risk Yönetimine Entegrasyonu ve Mekânsal Modellemesi.</p></div>
   <div><p>Erzincan Binali Yıldırım Üniversitesi bünyesinde yürütülmektedir.</p><p>Proje, TÜBİTAK 1001 kapsamında 226K193 numarasıyla desteklenmeye hak kazanmıştır.</p></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} MNEMORİSK</span><span>Bilimsel içerik · Türkçe ön sürüm</span></div>
 </div>
</footer>
<script>
 const button=document.querySelector('.menu-toggle');
 const nav=document.querySelector('#site-nav');
 button?.addEventListener('click',()=>{const open=nav?.classList.toggle('open');button.setAttribute('aria-expanded',String(!!open));});
 nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{nav.classList.remove('open');button?.setAttribute('aria-expanded','false');}));
</script>
</body>
</html>