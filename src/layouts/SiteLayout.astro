---
import { href, menu } from '../data/site.js';
const { title='MNEMORİSK', description='Erzincan’da deprem hafızası, risk algısı ve sosyal zarar görebilirlik üzerine araştırma.' } = Astro.props;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#f7f6f1" />
  <meta name="description" content={description} />
  <title>{title === 'MNEMORİSK' ? title : `${title} — MNEMORİSK`}</title>
  <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  <style is:global>
    :root{font-family:"Book Antiqua","Palatino Linotype",Palatino,"URW Palladio L",Georgia,serif;color:#243029;background:#f7f6f1;font-synthesis:none}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0} a{color:inherit;text-decoration:none} img,svg{max-width:100%}
    :focus-visible{outline:2px solid #b56850;outline-offset:4px}
    .wrap{width:min(1180px,calc(100% - 80px));margin:auto}
    .kicker,.nav,.eyebrow,.meta,.button,.index{font-family:Arial,Helvetica,sans-serif}
    .site-header{position:sticky;top:0;z-index:20;background:#f7f6f1ef;backdrop-filter:blur(14px);border-bottom:1px solid #d8ded5}
    .header-inner{min-height:86px;display:flex;align-items:center;justify-content:space-between;gap:28px}
    .brand{font-size:29px;font-weight:bold;letter-spacing:-.07em;line-height:1}.brand em{color:#af7057;font-style:normal}
    .desktop-nav{display:flex;gap:22px;align-items:center}.nav{font-size:12px;letter-spacing:.015em}.nav a{padding:7px 0}.nav a:hover,.nav a[aria-current=page]{color:#a05a46}
    .lang{border-left:1px solid #c9d0c7;padding-left:18px;color:#6e786f;cursor:not-allowed}
    .menu-toggle{display:none;cursor:pointer;border:1px solid #c9d0c7;border-radius:2px;padding:10px 13px;background:transparent;font:12px Arial}
    .main{min-height:55vh}.eyebrow,.kicker{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:bold;color:#5c7566}
    .hero{padding:94px 0 76px}.hero h1{max-width:950px;font-size:clamp(49px,7.4vw,106px);font-weight:normal;line-height:1.04;letter-spacing:-.065em;margin:28px 0 28px}
    .hero h1 span{color:#7a8e7f}.lead{font-size:clamp(19px,2.15vw,26px);line-height:1.55;color:#56675b;max-width:740px}
    .button{display:inline-flex;align-items:center;gap:28px;padding:17px 22px;background:#2b4235;color:#fff;font-size:13px;margin-top:20px}.button:hover{background:#42614b}
    .hero-art{position:relative;height:clamp(220px,36vw,460px);background:#dce0d6;overflow:hidden;border:1px solid #d6dbd2}
    .hero-art svg{width:100%;height:100%}.art-label{position:absolute;bottom:20px;left:25px;font:11px Arial;letter-spacing:.1em;color:#324c3b}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid #c9d0c7;padding:32px 0 60px;gap:25px}
    .stat strong{display:block;font-size:clamp(38px,5vw,68px);font-weight:normal;letter-spacing:-.06em}.stat span{font:12px Arial;color:#66776b}
    .content-band{padding:85px 0;border-bottom:1px solid #d5dcd3}.section-head{display:flex;justify-content:space-between;gap:24px;align-items:start}
    .section-head h2{font-weight:normal;letter-spacing:-.04em;font-size:clamp(32px,4.2vw,58px);line-height:1.12;margin:14px 0 24px;max-width:760px}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;margin-top:30px}.card{border:1px solid #cdd5cb;padding:27px;min-height:230px;background:#f4f5ef}.card .index{font-size:11px;color:#7f8f81}.card h3{font-size:27px;font-weight:normal;letter-spacing:-.03em;margin:37px 0 12px}.card p{font-size:16px;line-height:1.65;color:#627164;margin:0}
    .text-link{font:13px Arial;border-bottom:1px solid #7b9382;padding-bottom:6px;white-space:nowrap}
    .page-intro{padding:105px 0 70px;border-bottom:1px solid #d1d8cf}.page-intro h1{font-size:clamp(46px,6.4vw,88px);font-weight:normal;line-height:1.08;letter-spacing:-.06em;max-width:930px;margin:22px 0 27px}
    .page-intro p{font-size:clamp(19px,2vw,25px);color:#56685b;line-height:1.55;max-width:770px}
    .article-list{padding:40px 0 115px}.article-row{display:grid;grid-template-columns:1fr 2fr;gap:35px;padding:32px 0;border-bottom:1px solid #d5dcd3}.article-row h2{font-weight:normal;font-size:clamp(26px,3vw,38px);letter-spacing:-.035em;margin:0}.article-row p{font-size:18px;line-height:1.7;color:#5d6c60;margin:0}
    .notice{background:#e8ebe3;padding:25px 30px;font-size:15px;line-height:1.6;color:#485f4c}
    .site-footer{background:#243a30;color:#f2f0e8;padding:58px 0 35px}.footer-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:30px}.footer-title{font-size:36px;letter-spacing:-.06em}.site-footer p{font-size:15px;line-height:1.65;color:#c5d1c7;max-width:630px}.footer-bottom{border-top:1px solid #596d60;margin-top:55px;padding-top:25px;display:flex;justify-content:space-between;gap:25px;flex-wrap:wrap;font:12px Arial;color:#c4d0c6}
    @media(max-width:850px){.wrap{width:min(100% - 40px,1180px)}.header-inner{min-height:72px}.brand{font-size:26px}.menu-toggle{display:block}.desktop-nav{display:none;position:absolute;left:0;right:0;top:72px;background:#f7f6f1;padding:15px 20px 25px;border-bottom:1px solid #d8ded5;flex-direction:column;align-items:stretch;gap:0}.desktop-nav.open{display:flex}.desktop-nav a{display:block;padding:14px 0;border-bottom:1px solid #e2e7df}.desktop-nav .lang{border-left:0;padding:14px 0}.hero{padding:65px 0 47px}.cards{grid-template-columns:1fr}.card{min-height:unset}.card h3{margin-top:20px}.article-row{grid-template-columns:1fr;gap:12px}.footer-grid{grid-template-columns:1fr}}
    @media(max-width:540px){.wrap{width:calc(100% - 34px)}.hero h1{font-size:clamp(46px,12vw,65px)}.stats{gap:10px;padding-bottom:38px}.stat strong{font-size:39px}.stat span{font-size:11px}.content-band{padding:65px 0}.section-head{display:block}.text-link{display:inline-block;margin:0 0 18px}.page-intro{padding:65px 0 48px}.page-intro h1{font-size:47px}.article-list{padding-bottom:65px}.site-footer{padding-top:46px}}

    /* Unified editorial type scale and responsive rhythm */
    .header-inner{min-height:76px;gap:24px}
    .brand{font-size:27px;letter-spacing:-.052em;white-space:nowrap}
    .desktop-nav{gap:clamp(12px,1.6vw,23px)}
    .nav{font-size:13px;letter-spacing:0;line-height:1.4}
    .eyebrow,.kicker{font-size:12px;letter-spacing:.10em;line-height:1.5}
    .hero{padding:78px 0 60px}
    .hero h1{font-size:clamp(48px,6vw,82px);line-height:1.09;letter-spacing:-.047em;margin:20px 0 22px}
    .lead{font-size:clamp(18px,1.9vw,22px);line-height:1.62}
    .page-intro{padding:65px 0 42px}
    .page-intro h1{font-size:clamp(40px,5vw,66px);line-height:1.12;letter-spacing:-.04em;margin:15px 0 16px;max-width:960px}
    .page-intro p{font-size:clamp(17px,1.65vw,20px);line-height:1.6;margin:0;max-width:780px}
    .content-band{padding:65px 0}
    .section-head h2{font-size:clamp(30px,3.5vw,46px);line-height:1.18;letter-spacing:-.035em}
    .card h3{font-size:clamp(23px,2.2vw,29px);margin-top:28px}
    .article-list{padding:28px 0 75px}
    .article-row{padding:26px 0;gap:28px}
    .article-row h2{font-size:clamp(24px,2.5vw,33px)}
    .article-row p{font-size:17px;line-height:1.65}
    @media(max-width:850px){
      .header-inner{min-height:68px}
      .desktop-nav{top:68px}
      .nav{font-size:15px}
      .hero{padding:56px 0 44px}
      .page-intro{padding:52px 0 35px}
      .article-row{gap:9px}
    }
    @media(max-width:540px){
      .hero h1{font-size:clamp(42px,10vw,55px)}
      .page-intro{padding:42px 0 28px}
      .page-intro h1{font-size:clamp(36px,9vw,46px)}
      .page-intro p{font-size:17px}
      .content-band{padding:52px 0}
      .article-list{padding-bottom:55px}
    }
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  </style>
</head>
<body>
  <a href="#main" class="skip-link">İçeriğe geç</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href={href('')} class="brand" aria-label="MNEMORİSK ana sayfa">MNEMO<em>RİSK</em></a>
      <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">MENÜ ☰</button>
      <nav class="desktop-nav nav" id="site-nav" aria-label="Ana menü">
        {menu.map(item=><a href={href(item.path)} aria-current={current.endsWith('/'+item.path) ? 'page': undefined}>{item.label}</a>)}
        <span class="lang" title="İngilizce sürüm hazırlanıyor">EN / yakında</span>
      </nav>
    </div>
  </header>
  <main id="main" class="main"><slot /></main>
  <footer class="site-footer"><div class="wrap">
    <div class="footer-grid"><div><div class="footer-title">MNEMORİSK</div><p>Hafıza Temelli Sosyal Zarar Görebilirlik: Erzincan’da Toplumsal Hafızanın Afet Risk Yönetimine Entegrasyonu ve Mekânsal Modellemesi.</p></div><div><p>Erzincan Binali Yıldırım Üniversitesi bünyesinde yürütülmektedir.</p><p>Proje, TÜBİTAK 1001 kapsamında 226K193 numarasıyla desteklenmeye hak kazanmıştır.</p></div></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} MNEMORİSK</span><span>Bilimsel içerik · Türkçe ön sürüm</span></div>
  </div></footer>
  <script>
    const button=document.querySelector('.menu-toggle');
    const nav=document.querySelector('#site-nav');
    button?.addEventListener('click',()=>{const open=nav?.classList.toggle('open');button.setAttribute('aria-expanded',String(!!open));});
    nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{nav.classList.remove('open');button?.setAttribute('aria-expanded','false')}));
  </script>
  <style>.skip-link{position:absolute;left:-9999px;top:10px;background:white;z-index:40;padding:10px}.skip-link:focus{left:10px}</style>
</body>
</html>